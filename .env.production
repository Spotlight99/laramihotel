# PRODUCTION ENVIRONMENT VARIABLES
# This file contains production-only configuration
# It is NOT gitignored and serves as documentation
# Actual values should be set in Vercel Dashboard

# NOTE: NEXT_PUBLIC_* variables are embedded in the client bundle
# They MUST be set correctly for production to communicate with backend

# Backend API URL - MUST point to your deployed Django backend
# Examples:
#   Railway: https://larami-backend-prod.up.railway.app/api
#   Render: https://larami-hotel-backend.onrender.com/api
NEXT_PUBLIC_API_URL=https://your-django-backend-url/api

# Supabase Configuration (if using client-side features)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
